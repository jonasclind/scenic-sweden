{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scenic-web",
      "runtimeExecutable": "./.venv/bin/python",
      "runtimeArgs": ["scripts/serve.py"],
      "port": 8731,
      "autoPort": true
    },
    {
      "name": "scenic-dist",
      "runtimeExecutable": "./.venv/bin/python",
      "runtimeArgs": ["scripts/serve.py", "--root", "dist"],
      "port": 8732,
      "autoPort": true
    }
  ]
}
